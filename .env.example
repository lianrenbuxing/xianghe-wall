# 服务端口
PORT=3000

# 管理员密码（务必改成你自己的，默认值是项目里公开的）
ADMIN_PASSWORD=change-me-please

# 管理员 token 签名密钥；不填会自动生成并保存到 data/.secret
# SECRET=

# —— 数据库 ——
# 配了 TURSO_DATABASE_URL 就走云端 Turso；不配则用本地 data/wall.db（仅适合本机开发）
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# —— 图片 ——
# 三个都配了才走 Cloudinary；不配则存本地 data/uploads/（线上会随重启丢失）
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# 本地数据目录（仅本地 SQLite 模式用）
# DATA_DIR=./data

# 上线在 Nginx / Render 等反向代理后面时设为 1
# TRUST_PROXY=1

# 生产环境请设为 production（控制台不再打印密码）
# NODE_ENV=production
